                .from('gigs')
                .select(
                    'id, title, description, location, status, created_at, poster_id, agreed_price, payment_status'
                )
                .eq('poster_id', currentUser.id)
                .order('created_at', { ascending: false });

            if (gigsError) {
                errorMessage = gigsError.message;
                return;
            }

            gigs = (userGigs ?? []) as Gig[];

            if (gigs.length === 0) {
                applications = [];
                return;
            }

            const gigIds = gigs.map((gig) => gig.id);

            const {
                data: gigApplications,
                error: applicationsError
            } = await supabase
                .from('applications')
                .select('id, gig_id, worker_id, message, status, created_at')
                .in('gig_id', gigIds)
                .order('created_at', { ascending: false });

            if (applicationsError) {
                errorMessage = applicationsError.message;
                return;
            }

            applications = (gigApplications ?? []) as Application[];

            const workerIds = [
                ...new Set(
                    applications.map((application) => application.worker_id)
                )
            ];

                if (workerIds.length > 0) {
                    const { data: profiles, error: profilesError } = await supabase
                        .from('public_profile')
                        .select('user_id, full_name')
                        .in('user_id', workerIds);

                if (profilesError) {
                    errorMessage = profilesError.message;
                    return;
                }

                profileNames = Object.fromEntries(
                    (profiles ?? []).map((profile) => [
                        profile.user_id,
                        profile.full_name ?? 'Unknown applicant'
                    ])
                );
            }
        } catch (error) {
            errorMessage =
                error instanceof Error ? error.message : 'Something went wrong.';
        } finally {
            loading = false;
        }
    });

    async function updateGigStatus(
        gigId: number,
        status: 'open' | 'closed'
    ) {
        errorMessage = '';

        if (!user) {
            errorMessage = 'Please sign in again.';
            return;
        }

        updatingGigId = gigId;

        const { data, error } = await supabase
            .from('gigs')
            .update({ status })
            .eq('id', gigId)
            .eq('poster_id', user.id)
            .select('id');

        if (error) {
            errorMessage = error.message;
            updatingGigId = null;
            return;
        }

        if (!data || data.length === 0) {
            errorMessage =
                'The gig status was not changed. Refresh the dashboard and try again.';
            updatingGigId = null;
            return;
        }

        gigs = gigs.map((gig) =>
            gig.id === gigId ? { ...gig, status } : gig
        );

        updatingGigId = null;
    }

    async function markGigCompleted(gigId: number) {
        errorMessage = '';

        if (!user) {
            errorMessage = 'Your session is not ready. Please sign in again.';
            return;
        }

        const acceptedApplication = applications.find(
            (application) =>
                application.gig_id === gigId &&
                application.status === 'accepted'
        );

        if (!acceptedApplication) {
            errorMessage = 'This gig has no accepted worker.';
            return;
        }

        const gig = gigs.find((item) => item.id === gigId);

        if (!gig || gig.status !== 'closed') {
            errorMessage = 'Only closed gigs can be marked as completed.';
            return;
        }

        updatingGigId = gigId;

        const { data, error } = await supabase
            .from('gigs')
            .update({ status: 'completed' })
            .eq('id', gigId)
            .eq('poster_id', user.id)
            .eq('status', 'closed')
            .select('id');

        if (error) {
            errorMessage = error.message;
            updatingGigId = null;
            return;
        }

        if (!data || data.length === 0) {
            errorMessage =
                'The gig could not be marked completed. Check your database permissions and current gig status.';
            updatingGigId = null;
            return;
        }

        gigs = gigs.map((item) =>
            item.id === gigId ? { ...item, status: 'completed' } : item
        );

        updatingGigId = null;
    }

    async function deleteGig(gigId: number) {
        errorMessage = '';

        if (!user) {
            errorMessage = 'Please sign in again.';
            return;
        }

        deletingGigId = gigId;

        const { data, error } = await supabase
            .from('gigs')
            .delete()
            .eq('id', gigId)
            .eq('poster_id', user.id)
            .select('id');

        if (error) {
            errorMessage = error.message;
            deletingGigId = null;
            confirmingDeleteGigId = null;
            return;
        }

        if (!data || data.length === 0) {
            errorMessage =
                'The gig was not deleted. Refresh the dashboard and try again.';
            deletingGigId = null;
            confirmingDeleteGigId = null;
            return;
        }

        gigs = gigs.filter((gig) => gig.id !== gigId);
        applications = applications.filter(
            (application) => application.gig_id !== gigId
        );

        deletingGigId = null;
        confirmingDeleteGigId = null;
    }

    function startAcceptingApplication(applicationId: number) {
        errorMessage = '';
        acceptingApplicationId = applicationId;
        agreedPriceInput = '';
    }

    function cancelAcceptingApplication() {
        acceptingApplicationId = null;
        agreedPriceInput = '';
    }

    async function confirmAcceptApplication(
        applicationId: number,
        gigId: number
    ) {
        errorMessage = '';

        const agreedPrice = Number(agreedPriceInput);

        if (agreedPriceInput.trim() === '') {
            errorMessage = 'Please enter the agreed price.';
            return;
        }

        if (!Number.isFinite(agreedPrice) || agreedPrice <= 0) {
            errorMessage = 'Please enter a valid agreed price greater than 0.';
            return;
        }

        if (!Number.isInteger(agreedPrice)) {
            errorMessage = 'Please enter the agreed price as a whole number.';
            return;
        }

        if (!user) {
            errorMessage =
                'Your session is not ready. Please sign in again.';
            return;
        }

        if (updatingApplicationId !== null) {
            errorMessage = 'Please wait for the current operation to finish.';
            return;
        }

        const application = applications.find(
            (item) => item.id === applicationId && item.gig_id === gigId
        );

        if (!application || application.status !== 'pending') {
            errorMessage = 'This application is no longer pending.';
            return;
        }

        const gig = gigs.find((item) => item.id === gigId);

        if (!gig || gig.status !== 'open') {
            errorMessage = 'This gig is no longer open.';
            return;
        }

        updatingApplicationId = applicationId;

        try {
            const { data: closedGig, error: gigError } = await supabase
                .from('gigs')
                .update({
                    status: 'closed',
                    agreed_price: agreedPrice,
                    payment_status: 'unpaid'
                })
                .eq('id', gigId)
                .eq('poster_id', user.id)
                .eq('status', 'open')
                .select('id');

            if (gigError) {
                errorMessage = `Could not close the gig: ${gigError.message}`;
                return;
            }

            if (!closedGig || closedGig.length === 0) {
                errorMessage =
                    'The gig was not closed. It may already have been changed. Refresh the dashboard and try again.';
                return;
            }

            const {
                data: updatedApplication,
                error: applicationError
            } = await supabase
                .from('applications')
                .update({ status: 'accepted' })
                .eq('id', applicationId)
                .eq('gig_id', gigId)
                .eq('status', 'pending')
                .select('id');

            if (
                applicationError ||
                !updatedApplication ||
                updatedApplication.length === 0
            ) {
                const { data: reopenedGig, error: rollbackError } =
                    await supabase
                        .from('gigs')
                        .update({
                            status: 'open',
                            agreed_price: null,
                            payment_status: 'unpaid'
                        })
                        .eq('id', gigId)
                        .eq('poster_id', user.id)
                        .eq('status', 'closed')
                        .eq('agreed_price', agreedPrice)
                        .select('id');

                if (applicationError) {
                    errorMessage =
                        `Could not accept the applicant: ${applicationError.message}`;
                } else {
                    errorMessage =
                        'The application was not updated. Please refresh the dashboard and check its status.';
                }

                if (rollbackError) {
                    errorMessage +=
                        ` The gig could not be reopened automatically: ${rollbackError.message}. Please check its status.`;
                } else if (!reopenedGig || reopenedGig.length === 0) {
                    errorMessage +=
                        ' The gig was not reopened automatically. Please refresh the dashboard and check its status.';
                }

                return;
            }

            gigs = gigs.map((item) =>
                item.id === gigId
                    ? {
                          ...item,
                          status: 'closed',
                          agreed_price: agreedPrice,
                          payment_status: 'unpaid'
                      }
                    : item
            );

            applications = applications.map((item) =>
                item.id === applicationId
                    ? { ...item, status: 'accepted' }
                    : item
            );

            const { error: paymentError } = await supabase
                .from('payment_transactions')
                .insert({
                    gig_id: gigId,
                    payer_id: user.id,
                    worker_id: application.worker_id,
                    amount: agreedPrice,
                    status: 'pending'
                });

            if (paymentError) {
                errorMessage =
                    `The applicant was accepted, but the payment record could not be created: ${paymentError.message}. Please check the payment record before attempting another payment.`;
                return;
            }

            acceptingApplicationId = null;
            agreedPriceInput = '';
        } catch (error) {
            errorMessage =
                error instanceof Error
                    ? `An unexpected error occurred: ${error.message}`
                    : 'An unexpected error occurred while accepting the applicant. Refresh the dashboard and check the application and gig status.';
        } finally {
            updatingApplicationId = null;
        }
    }

    async function updateApplicationStatus(
        applicationId: number,
        status: 'accepted' | 'rejected'
    ) {
        if (status === 'accepted') {
            const application = applications.find(
                (item) => item.id === applicationId
            );

            if (!application) {
                errorMessage = 'Application not found.';
                return;
            }

            startAcceptingApplication(applicationId);
            return;
        }

        errorMessage = '';

        if (!user) {
            errorMessage = 'Please sign in again.';
            return;
        }

        if (updatingApplicationId !== null) {
            return;
        }

        const application = applications.find(
            (item) => item.id === applicationId
        );

        if (!application || application.status !== 'pending') {
            errorMessage = 'This application is no longer pending.';
            return;
        }

        const gig = gigs.find((item) => item.id === application.gig_id);

        if (!gig || gig.status !== 'open') {
            errorMessage = 'Only applications for open gigs can be rejected.';
            return;
        }

        updatingApplicationId = applicationId;

        try {
            const { data, error: applicationError } = await supabase
                .from('applications')
                .update({ status: 'rejected' })
                .eq('id', applicationId)
                .eq('gig_id', application.gig_id)
                .eq('status', 'pending')
                .select('id');

            if (applicationError) {
                errorMessage = applicationError.message;
                return;
            }

            if (!data || data.length === 0) {
                errorMessage =
                    'The application was not updated. Refresh the dashboard and try again.';
                return;
            }

            applications = applications.map((item) =>
                item.id === applicationId
                    ? { ...item, status: 'rejected' }
                    : item
            );
        } catch (error) {
            errorMessage =
                error instanceof Error
                    ? error.message
                    : 'An unexpected error occurred while rejecting the application.';
        } finally {
            updatingApplicationId = null;
        }
    }

    async function signOut() {
        await supabase.auth.signOut();
        goto('/login');
    }

    async function initiateMpesaPayment(gigId: number, workerId: string) {
        const key = paymentKey(gigId, workerId);
        paymentMessages[key] = '';

        const phone = posterPhone.trim();

        if (!phone) {
            paymentMessages[key] =
                posterPhoneError ||
                'Please add your phone number to your profile before requesting payment.';
            return;
        }

        const gig = gigs.find((item) => item.id === gigId);

        if (!gig || gig.payment_status === 'paid') {
            paymentMessages[key] = 'This gig is not awaiting payment.';
            return;
        }

        const acceptedApplication = applications.find(
            (application) =>
                application.gig_id === gigId &&
                application.worker_id === workerId &&
                application.status === 'accepted'
        );

        if (
            !acceptedApplication ||
            !['closed', 'completed'].includes(gig.status) ||
            gig.agreed_price === null ||
            gig.agreed_price < 1
        ) {
            paymentMessages[key] =
                'This worker or agreed price is not ready for payment.';
            return;
        }

        if (!user) {
            paymentMessages[key] = 'Please sign in again before paying.';
            return;
        }

        if (initiatingPaymentKey !== null) {
            return;
        }

        initiatingPaymentKey = key;

        try {
            const { data, error } = await supabase.functions.invoke(
                'mpesa-stk-push',
                {
                    body: {
                        gig_id: gigId,
                        worker_id: workerId,
                        phone_number: phone
                    }
                }
            );

            if (error) {
                paymentMessages[key] =
                    `Could not start payment: ${error.message}. Check the function deployment and logs.`;
                return;
            }

            if (!data?.success) {
                paymentMessages[key] =
                    data?.error ??
                    'The payment request could not be started. Please check its status before trying again.';
                return;
            }

            paymentMessages[key] =
                data.message ??
                'Payment request sent. Check the phone for the official M-Pesa prompt.';
        } catch (error) {
            paymentMessages[key] =
                error instanceof Error
                    ? error.message
                    : 'An unexpected error occurred while requesting payment.';
        } finally {
            initiatingPaymentKey = null;
        }
    }

    async function refreshPaymentStatus(gigId: number, workerId: string) {
        const key = paymentKey(gigId, workerId);

        if (!user) {
            paymentMessages[key] = 'Please sign in again.';
            return;
        }

        if (refreshingPaymentKey !== null) {
            return;
        }

        refreshingPaymentKey = key;

        try {
            const { data: transaction, error: transactionError } = await supabase
                .from('payment_transactions')
                .select('status, mpesa_receipt_number')
                .eq('gig_id', gigId)
                .eq('payer_id', user.id)
                .eq('worker_id', workerId)
                .maybeSingle();

            if (transactionError) {
                paymentMessages[key] =
                    `Could not refresh this worker's payment: ${transactionError.message}`;
                return;
            }

            if (!transaction) {
                paymentMessages[key] =
                    'No payment record found for this worker. Please contact support before attempting payment.';
                return;
            }

            const { data: gigData, error: gigError } = await supabase
                .from('gigs')
                .select('payment_status')
                .eq('id', gigId)
                .eq('poster_id', user.id)
                .maybeSingle();

            if (gigError) {
                paymentMessages[key] =
                    `Could not refresh gig status: ${gigError.message}`;
                return;
            }

            if (!gigData) {
                paymentMessages[key] = 'Could not find this gig.';
                return;
            }

            gigs = gigs.map((item) =>
                item.id === gigId
                    ? {
                          ...item,
                          payment_status: gigData.payment_status as 'unpaid' | 'paid'
                      }
                    : item
            );

            if (transaction.status === 'paid') {
                paymentMessages[key] = transaction.mpesa_receipt_number
                    ? `Payment confirmed. M-Pesa receipt: ${transaction.mpesa_receipt_number}`
                    : 'This worker’s payment has been confirmed by the server.';
            } else if (
                transaction.status === 'initiating' ||
                transaction.status === 'pending'
            ) {
                paymentMessages[key] =
                    'This worker’s payment is not yet confirmed. If you requested an STK Push, wait and refresh again.';
            } else {
                paymentMessages[key] =
                    `Current payment status: ${transaction.status}. Check the transaction before trying again.`;
            }
        } catch (error) {
            paymentMessages[key] =
                error instanceof Error
                    ? error.message
                    : 'Could not refresh payment status.';
        } finally {
            refreshingPaymentKey = null;
        }
    }
</script>

