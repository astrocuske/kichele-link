<script lang="ts">
	import { onMount } from 'svelte';
	import { goto } from '$app/navigation';
	import { supabase } from '#lib/supabase/client.ts';

	type Gig = {
		id: number;
		title: string;
		category: string | null;
		description: string;
		location: string | null;
		budget: number | null;
		status: string;
		created_at: string;
		poster_id: string;
		poster_name: string;
	};

	const categories = [
		'All',
		'Cleaning',
		'Construction',
		'Delivery',
		'Gardening',
		'Hair & Beauty',
		'Moving',
		'Repairs',
		'Transport',
		'Other'
	];

	let gigs = $state<Gig[]>([]);
	let selectedCategory = $state('All');
	let searchTerm = $state('');
	let loading = $state(true);
	let errorMessage = $state('');

	let filteredGigs = $derived(
		gigs.filter((gig) => {
			const matchesCategory =
				selectedCategory === 'All' || gig.category === selectedCategory;

			const search = searchTerm.trim().toLowerCase();

			const matchesSearch =
				search === '' ||
				gig.title.toLowerCase().includes(search) ||
				gig.description.toLowerCase().includes(search);

			return matchesCategory && matchesSearch;
		})
	);

	onMount(async () => {
		const {
			data: { user }
		} = await supabase.auth.getUser();

		if (!user) {
			await goto('/login');
			return;
		}

		const { data, error } = await supabase
			.from('gigs')
			.select(
				'id, title, category, description, location, budget, status, created_at, poster_id'
			)
			.eq('status', 'open')
			.order('created_at', { ascending: false });

		if (error) {
			console.error(error);
			errorMessage = error.message;
			loading = false;
			return;
		}

		const gigsData = data ?? [];

		const posterIds = [...new Set(gigsData.map((gig) => gig.poster_id))];

		let profiles: { user_id: string; full_name: string | null }[] = [];

		if (posterIds.length > 0) {
            const { data: profileData, error: profileError } = await supabase
                .from('public_profile')
                .select('user_id, full_name')
                .in('user_id', posterIds);

			if (profileError) {
				console.error(profileError);
			} else {
				profiles = profileData ?? [];
			}
		}

		const profileMap = new Map(
			profiles.map((profile) => [profile.user_id, profile.full_name])
		);

		gigs = gigsData.map((gig) => ({
			...gig,
			poster_name: profileMap.get(gig.poster_id) ?? 'Kichele Link user'
		}));

		loading = false;
	});
</script>

